*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/
ENV/
.env
.env.*

# Data artifacts (tracked sample fixtures preserved)
data/raw/*
!data/raw/sample_rss_feeds.json
!data/raw/sample_youtube_transcript.json
data/interim/*
